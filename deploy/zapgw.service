[Unit]
Description=zapgw — WhatsApp Cloud API gateway
Documentation=https://github.com/iscarelli/zapgw
# The service binds to a FIXED IP (ZAPGW_ENDERECO=<gateway-internal-ip>:8080).
# Without waiting for the network, ListenAndServe dies with "cannot assign
# requested address", Restart=always loops, and StartLimit shuts the service
# down for good — the CT comes up "normal" and the gateway simply is not there.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zapgw
Group=zapgw
ExecStart=/usr/local/bin/zapgw
WorkingDirectory=/var/lib/zapgw

# The encryption key (ZAPGW_CHAVE_CIFRA) lives HERE, outside the database and
# outside the repository. The file is 0600 zapgw:zapgw; PID 1 reads it before
# dropping privilege. deploy.sh does NOT copy or touch this file.
EnvironmentFile=/etc/zapgw/env

Restart=always
RestartSec=2s

# Logs go to journald (spec §9): no own log file, no rotation to forget to
# configure.
StandardOutput=journal
StandardError=journal

# Locks systemd gives for free. ProtectSystem=strict makes the ENTIRE
# filesystem read-only, including /usr/local/bin — that's why the deploy
# swaps the binary from outside the service (via pct exec), never from inside it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The only writable path: the database and the WAL's neighbors (zapgw.db-wal,
# zapgw.db-shm). Without this line SQLite fails on the first write, not on
# startup — the service comes up "ok" and only the first send exposes it.
ReadWritePaths=/var/lib/zapgw

[Install]
WantedBy=multi-user.target
