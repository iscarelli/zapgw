#!/bin/sh
# T-199's gate: blocks a push that INTRODUCES a real phone number or a real
# customer name, even when a LATER commit in the same push deletes the file
# again and the final tree is clean. Two things existed before this file:
#
#   1. Two tests (internal/config/telefones_allowlist_test.go,
#      internal/config/nomes_allowlist_test.go) that scan the WORKING TREE —
#      run by `go test ./...` and by CI, both AFTER a push already happened.
#      In a public repository "reprova depois" does not undo anything:
#      there is no despublicar.
#   2. Nothing that looked at the INTERVAL being pushed instead of the final
#      tree. A number added in commit A and removed in commit B leaves the
#      tree clean at commit B, but commit A still ships the moment the
#      branch reaches `origin`.
#
# This hook closes gap (2) by running internal/config/prepush_test.go's
# TestPrePushGate once per ref being pushed — it materializes what EACH
# commit in the pushed range actually introduces and runs the SAME two
# sweeps the tree-scanning tests use (no second implementation of the scan;
# see the comment at the top of prepush_test.go).
#
# 🔴 T-200: THE FIRST PUSH OF A BRAND-NEW REF USED TO BE REFUSED OUTRIGHT
# HERE, unconditionally, whenever git's pre-push protocol reported the
# remote sha as all zeros (no ref on the remote yet — nothing to diff a
# range against). Measured cost: that blocked EVERY new branch, including a
# clean one, and the only path left was `git push --no-verify` — i.e.
# turning this gate off. A gate that makes the legitimate path impossible
# does not protect anything; it teaches the bypass. See
# docs/ARMADILHAS.md for the full account.
#
# The fix does not live in this shell script: it lives in
# internal/config/prepush_test.go's commitsForPushedInterval, which computes
# "what this push introduces" with `git rev-list <new-sha> --not --remotes`
# instead of a range when the remote sha is zero — no merge-base is guessed.
# This hook now simply forwards BOTH shas to the test verbatim, zero or not,
# and lets the Go code decide which formula applies.
#
# 🔴 T-204: EVEN AFTER T-200, A TAG PUSH COULD STILL ONLY BE PUSHED WITH
# --no-verify — this project launches by tag, and the ORDINARY release flow
# (tag the commit AFTER it already merged to main) makes the pushed interval
# LEGITIMATELY EMPTY: the push adds a pointer, not a commit. T-199/T-200 had
# treated any empty interval as "the measurement is empty, fail closed",
# which is correct for "I could not compute the interval" and wrong for "I
# computed it, and it is genuinely zero." Same shape of defect as T-200,
# different disguise. This hook's own logic did not need to change for the
# fix — it already forwards both shas verbatim; the distinction (and the
# tag's own MESSAGE, swept unconditionally because it is free text a human
# wrote and it travels to `origin` too) lives entirely in
# internal/config/prepush_test.go. See docs/ARMADILHAS.md.
#
# ACTIVATION IS NOT AUTOMATIC. A file in .git/hooks/ is not versioned and
# does not survive a clone; this hook only runs once someone points git at
# this versioned directory:
#
#     git config core.hooksPath .githooks
#
# Confirm it is active with: git config --get core.hooksPath
#
# 🔴 `git push --no-verify` IS THE ONLY THING THAT DISABLES THIS GATE. Using
# it means you are choosing to push without this check running at all — not
# "skipping a slow test". If you ever type it against this repository, know
# that is exactly what you are turning off.

set -eu

zero="0000000000000000000000000000000000000000"

falha_fechada() {
    echo "" >&2
    echo "BLOCKED (.githooks/pre-push): $1" >&2
    echo "" >&2
    echo "This hook exists to keep a real phone number or a real name from" >&2
    echo "leaving this machine — even inside a commit that a LATER commit in" >&2
    echo "the same push deletes again. A clean final tree is not enough: the" >&2
    echo "repository is public and the history is not rewritten." >&2
    echo "" >&2
    echo "'git push --no-verify' is the ONLY thing that turns this guarantee off." >&2
    echo "Use it knowing you are TURNING OFF the gate, not skipping a slow test." >&2
    exit 1
}

if ! command -v go >/dev/null 2>&1; then
    falha_fechada "the 'go' binary is not in PATH — could not verify the interval being pushed."
fi

# Resolves the repo root to run 'go test' from it, regardless of where the
# hook was invoked from.
repo_root=$(git rev-parse --show-toplevel) || falha_fechada "could not locate the repository root."

# Reads from the hook's own stdin: one line per ref being pushed, in the
# format "<local-ref> <local-sha> <remote-ref> <remote-sha>" (git's protocol).
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref:-}" ] && continue

    # Deleting a remote ref (push --delete): nothing is being introduced.
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    export ZAPGW_PREPUSH_OLD_SHA="$remote_sha"
    export ZAPGW_PREPUSH_NEW_SHA="$local_sha"

    # stdin < /dev/null: 'go test' shouldn't read stdin, but inheriting the
    # same stdin the 'read' above is consuming line by line is the classic
    # way for a command inside the loop to steal the following lines.
    if ! (cd "$repo_root" && go test ./internal/config/ -run TestPrePushGate -v < /dev/null); then
        if [ "$remote_sha" = "$zero" ]; then
            falha_fechada "the new ref '$local_ref' (first push, no base on the remote) introduces personal data past a gate — see the test output above for the commit and the file."
        fi
        falha_fechada "the interval $remote_sha..$local_sha (ref '$local_ref') introduces personal data past a gate — see the test output above for the commit and the file."
    fi
done

exit 0
