# zapgw — environment variables
#
# COPY into the file the service reads (for example /etc/zapgw/env) and fill
# it in. THIS FILE HAS NO VALUE AT ALL, AND NEVER CAN: it is versioned, and a
# committed secret is not fixed with `git rm` — it's fixed by rotating it.
#
# The variables marked 🔴 are SECRET. They live in the service's file, with
# restricted permissions, and NEVER on a command line: every local process
# reads the command line via `ps`, and every configuration dump prints it.

# ---------------------------------------------------------------------------
# Required for the gateway to come up
# ---------------------------------------------------------------------------

# Where the process listens. Without a value, the binary won't come up.
ZAPGW_ENDERECO=

# Path to the SQLite database. The directory needs to exist and be writable.
ZAPGW_BANCO=

# 🔴 Encryption-at-rest key — 32 bytes in HEX (64 characters).
# It encrypts `callback_url`, tokens and instance secrets inside the database.
# CHANGING IT WITHOUT MIGRATING THE DATA MAKES EVERY INSTANCE UNREADABLE.
ZAPGW_CHAVE_CIFRA=

# The public URL through which Meta reaches the gateway. It's what appears in
# the `callback_url` you register on the App, and it is ALWAYS `https`.
ZAPGW_URL_PUBLICA=

# ---------------------------------------------------------------------------
# Inbound (Meta's webhook)
# ---------------------------------------------------------------------------

# How inbound traffic arrives: `direto` or `tunel`.
# 🔴 A value outside this list means the process WON'T COME UP — fails closed
# at startup, on purpose. Whoever edits this checks `journalctl -u zapgw`
# after restarting, not just `systemctl status`.
ZAPGW_ENTRADA_VIA=

# When `ZAPGW_ENTRADA_VIA=tunel`: the connector's readiness URL, used to
# publish how many connections are up on `/v1/estado`.
ZAPGW_CONECTOR_READY=

# ---------------------------------------------------------------------------
# Instance provisioning (used by the CLI, not by the service)
# ---------------------------------------------------------------------------

# 🔴 The Meta App's secret, used to verify each webhook's HMAC.
ZAPGW_APP_SECRET=

# Token Meta returns during the webhook verification (the handshake GET).
ZAPGW_VERIFY_TOKEN=

# 🔴 The instance's send token — the one that talks to the Graph API.
ZAPGW_TOKEN_ENVIO=

# 🔴 The secret the gateway uses to SIGN delivery to your `callback_url`.
# It's with this that you prove a delivery came from here.
ZAPGW_SEGREDO_ENTREGA=

# 🔴 PIN for a one-off administrative operation.
ZAPGW_PIN=

# ---------------------------------------------------------------------------
# High availability (optional — a single-node install doesn't use it)
# ---------------------------------------------------------------------------

# Leadership file. WITHOUT IT the singleton guard is NOT BUILT, and the
# install is byte-for-byte the single-node one.
# 🔴 The failure mode this leaves open is the worst possible one: TWO nodes
# with the guard disarmed because someone forgot the variable — which is the
# same message sent twice to the customer.
ZAPGW_LIDERANCA_ARQUIVO=
ZAPGW_LIDERANCA_VALIDADE=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# External probe that proves reachability from outside the network. Without
# it, `/v1/estado` publishes `alcance_externo` as not observed — which is
# different from "it's down".
ZAPGW_SONDA_EXTERNA_URL=

# ---------------------------------------------------------------------------
# Limits and retention (optional — has a default in the code)
# ---------------------------------------------------------------------------

ZAPGW_MAX_CORPO_BYTES=
ZAPGW_TTL_CONTADORES_DIAS=
ZAPGW_TTL_TRANSITO_DIAS=
ZAPGW_TTL_IDEMPOTENCIA_HORAS=

# ---------------------------------------------------------------------------
# Pointing at another host (test and lab)
# ---------------------------------------------------------------------------

# Graph API base. Exists so the smoke test can talk to a fake graph instead
# of Meta. In production, leave it EMPTY.
ZAPGW_GRAPH_BASE=

# Instagram token-refresh base, for the same reason.
ZAPGW_INSTAGRAM_REFRESH_BASE=

# Turns on an extra probe in Instagram's `diagnostico`.
ZAPGW_DIAGNOSTICO_SONDAR_FOLDER=
