# zapgw — variaveis de ambiente
#
# COPIE para o arquivo que o servico le (por exemplo /etc/zapgw/env) e preencha.
# ESTE ARQUIVO NAO TEM VALOR NENHUM, E NUNCA PODE TER: ele e' versionado, e
# segredo commitado nao se conserta com `git rm` — se conserta rotacionando.
#
# As variaveis com 🔴 sao SEGREDO. Elas moram no arquivo do servico, com
# permissao restrita, e NUNCA em linha de comando: todo processo local le a
# linha de comando pelo `ps`, e todo dump de configuracao a imprime.

# ---------------------------------------------------------------------------
# Obrigatorias para o gateway subir
# ---------------------------------------------------------------------------

# Onde o processo escuta. Sem valor, o binario nao sobe.
ZAPGW_ENDERECO=

# Caminho do banco SQLite. O diretorio precisa existir e ser gravavel.
ZAPGW_BANCO=

# 🔴 Chave de cifra em repouso — 32 bytes em HEX (64 caracteres).
# Ela cifra `callback_url`, tokens e segredos das instancias dentro do banco.
# TROCA-LA SEM MIGRAR OS DADOS TORNA TODA INSTANCIA ILEGIVEL.
ZAPGW_CHAVE_CIFRA=

# URL publica pela qual a Meta alcanca o gateway. E' o que aparece no
# `callback_url` que voce cadastra no App, e ela e' `https` sempre.
ZAPGW_URL_PUBLICA=

# ---------------------------------------------------------------------------
# Entrada (webhook da Meta)
# ---------------------------------------------------------------------------

# Por onde o trafego de entrada chega: `direto` ou `tunel`.
# 🔴 Valor fora da lista NAO SOBE — falha fechada no arranque, de proposito.
# Quem editar isto confere `journalctl -u zapgw` depois de reiniciar, nao so' o
# `systemctl status`.
ZAPGW_ENTRADA_VIA=

# Quando `ZAPGW_ENTRADA_VIA=tunel`: URL de prontidao do conector, usada para
# publicar quantas conexoes estao de pe no `/v1/estado`.
ZAPGW_CONECTOR_READY=

# ---------------------------------------------------------------------------
# Provisionamento de instancia (usadas pelo CLI, nao pelo servico)
# ---------------------------------------------------------------------------

# 🔴 Segredo do App da Meta, usado para conferir o HMAC de cada webhook.
ZAPGW_APP_SECRET=

# Token que a Meta devolve na verificacao do webhook (o GET de handshake).
ZAPGW_VERIFY_TOKEN=

# 🔴 Token de envio da instancia — o que fala com a Graph API.
ZAPGW_TOKEN_ENVIO=

# 🔴 Segredo com que o gateway ASSINA a entrega no seu `callback_url`.
# E' com ele que voce prova que a entrega veio daqui.
ZAPGW_SEGREDO_ENTREGA=

# 🔴 PIN de uma operacao administrativa pontual.
ZAPGW_PIN=

# ---------------------------------------------------------------------------
# Alta disponibilidade (opcional — instalacao de no unico nao usa)
# ---------------------------------------------------------------------------

# Arquivo de lideranca. SEM ELE a guarda de singleton NAO E' CONSTRUIDA, e a
# instalacao e' bit a bit a de no unico.
# 🔴 O modo de falha que isso deixa aberto e' o pior possivel: DOIS nos com a
# guarda desarmada porque alguem esqueceu a variavel — que e' a mesma mensagem
# enviada duas vezes para a cliente.
ZAPGW_LIDERANCA_ARQUIVO=
ZAPGW_LIDERANCA_VALIDADE=

# ---------------------------------------------------------------------------
# Observacao (opcional)
# ---------------------------------------------------------------------------

# Sonda externa que prova alcance de fora da rede. Sem ela, o `/v1/estado`
# publica `alcance_externo` como nao observado — que e' diferente de "esta fora".
ZAPGW_SONDA_EXTERNA_URL=

# ---------------------------------------------------------------------------
# Limites e retencao (opcional — tem default no codigo)
# ---------------------------------------------------------------------------

ZAPGW_MAX_CORPO_BYTES=
ZAPGW_TTL_CONTADORES_DIAS=
ZAPGW_TTL_TRANSITO_DIAS=
ZAPGW_TTL_IDEMPOTENCIA_HORAS=

# ---------------------------------------------------------------------------
# Apontamento para outro host (teste e laboratorio)
# ---------------------------------------------------------------------------

# Base da Graph API. Existe para o teste de fumaca falar com um grafo falso em
# vez da Meta. Em producao, deixe VAZIO.
ZAPGW_GRAPH_BASE=

# Base do refresh de token do Instagram, pela mesma razao.
ZAPGW_INSTAGRAM_REFRESH_BASE=

# Liga uma sondagem extra no `diagnostico` do Instagram.
ZAPGW_DIAGNOSTICO_SONDAR_FOLDER=
